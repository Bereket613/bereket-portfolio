# Port (Render/Railway set this automatically)
PORT=5000

# PostgreSQL connection string (Supabase / Neon / local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Secret used to sign admin JWTs - set a long random value in production
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated list of additional allowed frontend origins (optional)
# Example: https://bereket-portfolio.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=
